# ==============================================================================
# Variables de entorno para el Servicio Central (Notebook B / Servidor Central)
# ==============================================================================
# Copiar este archivo a .env:
#   cp servicio/.env.example servicio/.env
# Completar con la contraseña de usuario "servicio" en EMQX (no subir .env a git)

# IP de la notebook del broker. No usar 127.0.0.1 con Docker: adentro del container
# es el propio container. La IP tiene que estar en el certificado del broker.
MQTT_HOST=<ip-del-broker>
MQTT_PORT=8883
MQTT_USUARIO=servicio
MQTT_PASSWORD=cambiar_password_servicio

# Ruta relativa a la raiz del repo, para correr el servicio sin Docker.
# Con Docker no se usa: compose.yaml la reemplaza por /certs/ca.crt
MQTT_CA_CERTS=broker/certs/ca.crt

# Ruta del archivo SQLite. Con Docker queda dentro del volumen servicio_datos
SERVICIO_DB=servicio/data/bd_servicio.db
