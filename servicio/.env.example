# ==============================================================================
# Variables de entorno para el Servicio Central (Notebook B / Servidor Central)
# ==============================================================================
# Copiar este archivo a .env:
#   cp servicio/.env.example servicio/.env
# Completar con la contraseña de usuario "servicio" en EMQX (no subir .env a git)

MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USUARIO=servicio
MQTT_PASSWORD=cambiar_password_servicio
MQTT_CA_CERTS=../broker/certs/ca.crt
